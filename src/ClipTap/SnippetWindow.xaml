<Window x:Class="ClipTap.SnippetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="快捷片段" Width="440" Height="560"
        Style="{StaticResource {x:Type Window}}" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,22">
      <TextBlock x:Name="Heading" Text="新建快捷片段" FontSize="21" FontWeight="SemiBold" />
      <TextBlock Text="给常用内容一个好记的名字。" Foreground="{DynamicResource Muted}" Margin="0,7,0,0" />
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,15">
      <TextBlock Text="标题" Margin="0,0,0,7" /><TextBox x:Name="TitleInput" MaxLength="80" AutomationProperties.Name="片段标题" />
    </StackPanel>
    <Grid Grid.Row="2" Margin="0,0,0,6">
      <TextBlock Text="内容" VerticalAlignment="Center" />
      <CheckBox x:Name="SensitiveInput" Content="敏感内容" HorizontalAlignment="Right" Checked="OnModeChanged" Unchecked="OnModeChanged" />
    </Grid>
    <Grid Grid.Row="3">
      <TextBox x:Name="ValueInput" Height="112" MaxLength="20000" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="片段内容" />
      <PasswordBox x:Name="SecretInput" Height="112" MaxLength="20000" VerticalContentAlignment="Top" Visibility="Collapsed" AutomationProperties.Name="敏感片段内容" />
    </Grid>
    <StackPanel Grid.Row="4" Margin="0,9,0,0">
      <CheckBox x:Name="RevealInput" Content="显示内容" Visibility="Collapsed" Checked="OnRevealChanged" Unchecked="OnRevealChanged" />
      <CheckBox x:Name="PinnedInput" Content="置顶，在列表中优先显示" />
    </StackPanel>
    <TextBlock x:Name="ErrorLabel" Grid.Row="5" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Margin="0,0,0,12" />
    <Grid Grid.Row="6">
      <Button x:Name="DeleteButton" Content="删除" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource Danger}" Click="OnDelete" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" IsCancel="True" Margin="0,0,8,0" />
        <Button Content="保存片段" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" Click="OnSave" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
