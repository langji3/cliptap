<Window x:Class="ClipTap.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ClipTap.Views"
        Title="ClipTap" Width="448" Height="500" Style="{StaticResource {x:Type Window}}"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="OnKeyDown" Deactivated="OnDeactivated" Closing="OnClosing"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border x:Name="PanelSurface" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Page}">
    <Border.RenderTransform><TranslateTransform x:Name="EntranceOffset" /></Border.RenderTransform>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="66" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid x:Name="HeaderDragArea" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="OnHeaderDrag">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
          <Border x:Name="BrandIcon" Width="30" Height="30" CornerRadius="9" Background="{DynamicResource Accent}" Margin="0,0,10,0">
            <Viewbox Width="30" Height="30"><Canvas Width="64" Height="64">
              <Path Data="M24,18 L21,18 Q17,18 17,23 L17,50 Q17,55 22,55 L44,55 Q49,55 49,50 L49,23 Q49,18 44,18 L42,18" Stroke="{DynamicResource OnAccent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              <Rectangle Canvas.Left="25" Canvas.Top="11" Width="16" Height="13" RadiusX="4" RadiusY="4" Stroke="{DynamicResource OnAccent}" StrokeThickness="4" />
              <Path Data="M26,35 L40,35 M26,44 L35,44" Stroke="{DynamicResource OnAccent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas></Viewbox>
          </Border>
          <Button x:Name="BackButton" Style="{StaticResource IconButton}" Visibility="Collapsed" Margin="-6,0,8,0" ToolTip="返回" AutomationProperties.Name="返回" Click="OnBack">
            <Path Data="M14,5 L7,12 L14,19" Width="20" Height="24" Stroke="{DynamicResource Ink}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Button>
          <TextBlock x:Name="PageTitle" Text="ClipTap" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Margin="0,0,18,0" HorizontalAlignment="Right" ToolTip="设置" AutomationProperties.Name="设置" Click="OnSettings">
          <Canvas Width="22" Height="22">
            <Path Data="M3,5 L19,5 M3,11 L19,11 M3,17 L19,17" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Ellipse Canvas.Left="6" Canvas.Top="2.5" Width="5" Height="5" Fill="{DynamicResource Page}" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" />
            <Ellipse Canvas.Left="12" Canvas.Top="8.5" Width="5" Height="5" Fill="{DynamicResource Page}" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" />
            <Ellipse Canvas.Left="5" Canvas.Top="14.5" Width="5" Height="5" Fill="{DynamicResource Page}" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" />
          </Canvas>
        </Button>
      </Grid>
      <Grid x:Name="ListPage" Grid.Row="1">
        <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="46" /></Grid.RowDefinitions>
        <Border Margin="18,0,18,6" Background="{DynamicResource Chrome}" CornerRadius="9" Padding="4">
          <UniformGrid Columns="2">
            <Button x:Name="HistoryTab" Content="剪贴板" Click="OnHistoryTab" Padding="8,5" />
            <Button x:Name="SnippetsTab" Content="快捷片段" Click="OnSnippetsTab" Padding="8,5" />
          </UniformGrid>
        </Border>
        <Grid x:Name="HistoryToolbar" Grid.Row="1" Margin="20,2,20,6" Height="30">
          <TextBlock Text="剪贴板" VerticalAlignment="Center" FontSize="12" />
          <Button x:Name="ClearHistoryButton" Content="全部清除" HorizontalAlignment="Right" Padding="10,4" FontSize="11" Click="OnClearHistory" />
        </Grid>
        <Grid Grid.Row="2" Margin="12,4,12,0">
          <ListBox x:Name="Entries" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   SelectionMode="Single" PreviewMouseLeftButtonUp="OnEntryClick" AutomationProperties.Name="条目列表">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
              <Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="10,8" /><Setter Property="Margin" Value="0,3" />
              <Setter Property="MinHeight" Value="76" />
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Row" Background="{DynamicResource Field}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Ink}" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Setter.Value></Setter>
            </Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
              <Grid ToolTip="{Binding Detail}">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Path Width="17" Height="19" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" HorizontalAlignment="Left">
                  <Path.Style><Style TargetType="Path">
                    <Setter Property="Data" Value="M5,2 L13,2 L17,6 L17,20 L3,20 L3,2 Z M7,9 L13,9 M7,13 L13,13" />
                    <Style.Triggers><DataTrigger Binding="{Binding Sensitive}" Value="True"><Setter Property="Data" Value="M5,9 L5,6 A5,5 0 0 1 15,6 L15,9 M3,9 L17,9 L17,20 L3,20 Z M10,13 L10,16" /></DataTrigger><DataTrigger Binding="{Binding IsImage}" Value="True"><Setter Property="Data" Value="M2,3 L18,3 L18,19 L2,19 Z M2,16 L7,10 L12,15 L15,12 L18,16 M12,7 L14,7" /></DataTrigger></Style.Triggers>
                  </Style></Path.Style>
                </Path>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                  <Image Source="{Binding Thumbnail}" MaxWidth="160" Height="80" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,6">
                    <Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Image.Style>
                  </Image>
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                  <Button Content="⋯" Style="{StaticResource IconButton}" Width="28" Height="26" FontSize="18" ToolTip="更多" AutomationProperties.Name="更多操作" Click="OnMore" />
                  <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="5,0,0,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Pinned}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Right" Margin="0,8,0,0">
                  <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ActionsOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                  <Button Content="删除" Padding="12,5" Foreground="{DynamicResource Danger}" Click="OnDeleteHistory" />
                </StackPanel>
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <Grid Grid.Row="3" Margin="22,0,22,8">
          <TextBlock x:Name="StatusLabel" Text="Alt+空格唤醒" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
          <Button x:Name="SystemSettingsButton" Content="打开设置" Visibility="Collapsed" HorizontalAlignment="Right" Padding="10,6" Background="Transparent" Foreground="{DynamicResource Accent}" Click="OnSystemSettings" />
          <StackPanel x:Name="SnippetActions" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="EditButton" Style="{StaticResource IconButton}" ToolTip="编辑 · F2" AutomationProperties.Name="编辑片段" Click="OnEdit" Margin="0,0,4,0">
              <Path Data="M4,15 L4,20 L9,20 L20,9 L15,4 Z M13,6 L18,11" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeLineJoin="Round" />
            </Button>
            <Button x:Name="NewButton" Style="{StaticResource IconButton}" ToolTip="新建片段" AutomationProperties.Name="新建片段" Click="OnNew">
              <Path Data="M11,4 L11,18 M4,11 L18,11" Width="22" Height="22" Stroke="{DynamicResource Accent}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
      <ContentControl x:Name="PageHost" Grid.Row="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      <views:InlineConfirmation x:Name="Confirmation" Grid.Row="2" Margin="22,0,22,10" />
    </Grid>
  </Border>
</Window>
