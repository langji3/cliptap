<Window x:Class="ClipTap.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ClipTap.Views"
        Title="ClipTap" Width="760" Height="74" Style="{StaticResource {x:Type Window}}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="OnKeyDown" Deactivated="OnDeactivated" Closing="OnClosing"
        PreviewMouseLeftButtonDown="OnPanelMouseDown" PreviewMouseLeftButtonUp="OnEntryClick"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border x:Name="PanelSurface" Background="{DynamicResource Page}" BorderThickness="1" CornerRadius="14">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="EntranceScale"/><TranslateTransform x:Name="EntranceOffset"/></TransformGroup></Border.RenderTransform>
    <Grid x:Name="PanelContent" SizeChanged="OnPanelContentSizeChanged">
      <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="HeaderDragArea" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag" Margin="20,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
        <Border x:Name="BrandIcon" Width="30" Height="30" HorizontalAlignment="Left">
          <Path Data="M16,9 A7,7 0 1 1 2,9 A7,7 0 1 1 16,9 M14,14 L21,21" Width="22" Height="22" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Button x:Name="BackButton" Style="{StaticResource IconButton}" Width="28" Height="28" Visibility="Collapsed" ToolTip="返回" AutomationProperties.Name="返回" Click="OnBack" Content="←"/>
        <Grid x:Name="SearchHeader" Grid.Column="1" Margin="0,0,12,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Padding="0" FontSize="18" CaretBrush="{DynamicResource Accent}" VerticalContentAlignment="Center" MaxLength="200" AutomationProperties.Name="搜索" TextChanged="OnSearchChanged"/>
          <TextBlock x:Name="SearchHint" FontSize="18" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <Button x:Name="ClearSearchButton" Grid.Column="1" Style="{StaticResource IconButton}" Width="24" Height="24" Visibility="Collapsed" ToolTip="清空搜索" AutomationProperties.Name="清空搜索" Click="OnClearSearch" Content="×"/>
        </Grid>
        <TextBlock x:Name="PageTitle" Grid.Column="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed"/>
        <ComboBox x:Name="TypeFilter" Grid.Column="2" Width="134" Height="34" VerticalAlignment="Center" SelectedValuePath="Tag" SelectionChanged="OnTypeFilterChanged" AutomationProperties.Name="内容类型">
          <ComboBoxItem Content="全部类型" Tag="all" IsSelected="True"/><ComboBoxItem Content="文本" Tag="text"/><ComboBoxItem Content="链接" Tag="link"/><ComboBoxItem Content="图片" Tag="image"/>
        </ComboBox>
        <TextBlock x:Name="ScopeLabel" Grid.Column="2" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button x:Name="SettingsButton" Grid.Column="3" Style="{StaticResource IconButton}" HorizontalAlignment="Right" ToolTip="设置" AutomationProperties.Name="设置" Click="OnSettings">
          <Path Data="M2,4 L18,4 M2,10 L18,10 M2,16 L18,16 M6,1 L6,7 M13,7 L13,13 M7,13 L7,19" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.5"/>
        </Button>
      </Grid>
      <Grid x:Name="ListPage" Grid.Row="1" Visibility="Collapsed" ClipToBounds="True">
        <Grid.RenderTransform><TranslateTransform x:Name="ResultsOffset"/></Grid.RenderTransform>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="46"/></Grid.RowDefinitions>
        <Border BorderThickness="0,1" BorderBrush="{DynamicResource Line}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.39*"/><ColumnDefinition Width="0.61*"/></Grid.ColumnDefinitions>
            <Grid x:Name="ListPane">
              <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/></Grid.RowDefinitions>
              <Grid Margin="14,0"><TextBlock x:Name="SectionLabel" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="CountLabel" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
              <ListBox x:Name="Entries" Grid.Row="1" Margin="6,0,6,6" Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnEntryDoubleClick" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                  <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                  <Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,1"/><Setter Property="MinHeight" Value="44"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="RowSurface" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                      <Grid><Border x:Name="SelectionMark" Width="3" Height="18" CornerRadius="1.5" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Margin="-6,0,0,0" Visibility="Collapsed"/><ContentPresenter/></Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                      <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource Selected}"/><Setter TargetName="SelectionMark" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate></Setter.Value></Setter>
                </Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                  <Grid ToolTip="{Binding Hint}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="5" Background="{DynamicResource Chrome}" Padding="3" HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True">
                      <Grid>
                        <Path x:Name="TextGlyph" Data="M4,2 L12,2 L17,7 L17,20 L4,20 Z M12,2 L12,7 L17,7" Width="13" Height="18" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.5"/>
                        <TextBlock x:Name="SnippetGlyph" Text="S" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Visibility="Collapsed"/>
                        <Path x:Name="ImageFallbackGlyph" Data="M1,1 L21,1 L21,17 L1,17 Z M3,14 L8,8 L12,12 L16,6 L20,14" Width="21" Height="17" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" Visibility="Collapsed"/>
                        <Image x:Name="ImageGlyph" Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                      <TextBlock x:Name="RowTitle" Text="{Binding Title}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                      <Grid><TextBlock x:Name="RowMeta" Text="{Binding Meta}" Foreground="{DynamicResource Muted}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,2,36,0"/><TextBlock x:Name="RowTime" Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Margin="0,2,0,0"/></Grid>
                    </StackPanel>
                    <StackPanel x:Name="RowHandles" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource RowActionButton}" Width="22" Height="26" ToolTip="更多操作" AutomationProperties.Name="更多操作" Content="⋯" Click="OnMore"/>
                    </StackPanel>
                    <Button x:Name="DeleteAction" Grid.Column="2" Style="{StaticResource QuietButton}" Content="删除" Visibility="Collapsed" Click="OnDeleteHistory"/>
                    <Button x:Name="PinApplication" Grid.Column="2" Style="{StaticResource RowActionButton}" Width="28" Height="28" Content="☆" ToolTip="搜索时优先显示" AutomationProperties.Name="搜索时优先显示" Visibility="Collapsed" Click="OnPinApplication"/>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsApplication}" Value="True"><Setter TargetName="PinApplication" Property="Visibility" Value="Visible"/></DataTrigger>
                    <DataTrigger Binding="{Binding Pinned}" Value="True"><Setter TargetName="PinApplication" Property="Content" Value="★"/><Setter TargetName="PinApplication" Property="ToolTip" Value="取消优先显示"/><Setter TargetName="PinApplication" Property="AutomationProperties.Name" Value="取消优先显示"/></DataTrigger>
                    <DataTrigger Binding="{Binding Meta}" Value=""><Setter TargetName="RowMeta" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsSnippet}" Value="True"><Setter TargetName="TextGlyph" Property="Visibility" Value="Collapsed"/><Setter TargetName="SnippetGlyph" Property="Visibility" Value="Visible"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsImage}" Value="True"><Setter TargetName="TextGlyph" Property="Visibility" Value="Collapsed"/><Setter TargetName="ImageGlyph" Property="Visibility" Value="Visible"/><Setter TargetName="ImageGlyph" Property="Stretch" Value="UniformToFill"/></DataTrigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsImage}" Value="True"/><Condition Binding="{Binding Thumbnail}" Value="{x:Null}"/></MultiDataTrigger.Conditions><Setter TargetName="ImageFallbackGlyph" Property="Visibility" Value="Visible"/></MultiDataTrigger>
                    <DataTrigger Binding="{Binding IsApplication}" Value="True"><Setter TargetName="ImageGlyph" Property="Visibility" Value="Visible"/><Setter TargetName="RowHandles" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsCommand}" Value="True"><Setter TargetName="RowHandles" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding ActionsOpen}" Value="True"><Setter TargetName="RowHandles" Property="Visibility" Value="Collapsed"/><Setter TargetName="RowTime" Property="Visibility" Value="Collapsed"/><Setter TargetName="DeleteAction" Property="Visibility" Value="Visible"/></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <StackPanel x:Name="EmptyState" Grid.Row="1" Margin="20" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="EmptyTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock x:Name="EmptyDetail" Margin="0,8,0,14" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button x:Name="EmptyActionButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Center" Click="OnEmptyAction" Visibility="Collapsed"/>
              </StackPanel>
            </Grid>
            <Border x:Name="PreviewPane" Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Line}" Background="{DynamicResource PreviewSurface}">
              <Grid Margin="20,16,20,10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="PreviewTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <StackPanel x:Name="ImageZoomActions" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="ImageFitButton" Content="适应" Tag="0" Style="{StaticResource QuietButton}" Padding="6,2" FontSize="11" Click="OnImageZoom"/>
                    <Button x:Name="ImageActualButton" Content="100%" Tag="1" Style="{StaticResource QuietButton}" Padding="6,2" FontSize="11" Click="OnImageZoom"/>
                    <Button x:Name="ImageDoubleButton" Content="200%" Tag="2" Style="{StaticResource QuietButton}" Padding="6,2" FontSize="11" Click="OnImageZoom"/>
                  </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,16">
                  <TextBox x:Name="PreviewText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Padding="0" FontSize="14" VerticalContentAlignment="Top" Visibility="Collapsed" AutomationProperties.Name="内容预览"/>
                  <Border x:Name="PreviewImageFrame" Padding="8" Background="{DynamicResource Chrome}" CornerRadius="6" Visibility="Collapsed">
                    <ScrollViewer x:Name="ImageViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" SizeChanged="OnImageViewportSizeChanged">
                      <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="图片预览"/>
                    </ScrollViewer>
                  </Border>
                  <StackPanel x:Name="PreviewEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="310">
                    <Border Width="52" Height="52" Background="{DynamicResource Chrome}" CornerRadius="10" Margin="0,0,0,16"><Grid><TextBlock Text="⌘" FontSize="28" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="PreviewAppIcon" Width="40" Height="40" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></Border>
                    <TextBlock x:Name="PreviewEmptyTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock x:Name="PreviewEmptyDetail" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                  </StackPanel>
                </Grid>
                <StackPanel x:Name="PreviewInfo" Grid.Row="2">
                  <TextBlock Text="详细信息" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,10"/>
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,8"><Grid><TextBlock Text="类型" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="PreviewKind" FontSize="12" HorizontalAlignment="Right"/></Grid></Border>
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,8"><Grid><TextBlock x:Name="PreviewMetaLabel" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="PreviewMeta" FontSize="12" HorizontalAlignment="Right"/></Grid></Border>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
        <Grid x:Name="HistoryToolbar" Grid.Row="1" Margin="10,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="HomeButton" Style="{StaticResource QuietButton}" Content="⌂" Width="28" ToolTip="首页" AutomationProperties.Name="首页" Click="OnHome"/>
            <Button x:Name="HistoryTab" Style="{StaticResource QuietButton}" Content="Clipboard" Padding="7,4" FontSize="12" Click="OnHistoryTab"/>
            <Button x:Name="SnippetsTab" Style="{StaticResource QuietButton}" Content="Snip" Padding="7,4" FontSize="12" Click="OnSnippetsTab"/>
            <TextBlock x:Name="StatusLabel" MaxWidth="178" Margin="10,0,0,0" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="SystemSettingsButton" Style="{StaticResource QuietButton}" Content="去开启" Click="OnSystemSettings" Visibility="Collapsed"/>
            <StackPanel x:Name="SnippetActions" Orientation="Horizontal" Visibility="Collapsed"><Button x:Name="EditButton" Style="{StaticResource QuietButton}" Content="编辑" FontSize="12" Padding="6,4" Click="OnEdit"/><Button x:Name="NewButton" Style="{StaticResource QuietButton}" Content="新建" FontSize="12" Padding="6,4" Click="OnNew"/></StackPanel>
            <TextBlock x:Name="ShortcutLabel" Text="↑↓ 选择" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="4,0,8,0"/>
            <Button x:Name="PasteButton" Style="{StaticResource QuietButton}" Content="打开 ↵" Padding="8,4" FontSize="12" Click="OnUseSelected"/>
            <Border Width="1" Height="14" Background="{DynamicResource Line}" Margin="8,0"/>
            <Button x:Name="MoreButton" Style="{StaticResource QuietButton}" Content="操作 ···" Padding="6,4" FontSize="12" ToolTip="操作（Ctrl+K）" Click="OnMoreMenu"/>
          </StackPanel>
        </Grid>
      </Grid>
      <ContentControl x:Name="PageHost" Grid.Row="1" Visibility="Collapsed" MaxWidth="560" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      <views:InlineConfirmation x:Name="Confirmation" Grid.Row="1" VerticalAlignment="Bottom" Margin="12,0,12,50"/>
      <Grid x:Name="MenuLayer" Grid.Row="1" Visibility="Collapsed" Focusable="True" KeyboardNavigation.TabNavigation="Cycle">
        <Border x:Name="MenuBackdrop" Background="Transparent" MouseLeftButtonDown="OnMenuBackdrop"/>
        <Border Background="{DynamicResource FieldBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,0,12,50" Width="236">
          <StackPanel><Button x:Name="MenuRefreshAppsButton" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Content="刷新应用列表" Click="OnRefreshApplications"/><Button x:Name="MenuClearButton" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Content="清空 Windows 剪贴板历史" Click="OnClearHistory"/><TextBlock x:Name="MenuHint" Text="Win+V 中的固定项会保留" Margin="8,5" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
