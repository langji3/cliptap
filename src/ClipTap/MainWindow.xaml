<Window x:Class="ClipTap.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ClipTap" Width="448" Height="500"
        Style="{StaticResource {x:Type Window}}" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="OnKeyDown" Deactivated="OnDeactivated" Closing="OnClosing"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Page}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="68" /><RowDefinition Height="50" /><RowDefinition Height="34" />
        <RowDefinition Height="*" /><RowDefinition Height="48" /><RowDefinition Height="39" />
      </Grid.RowDefinitions>
      <Grid x:Name="HeaderDragArea" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="OnHeaderDrag">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
          <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource Accent}" Margin="0,0,10,0">
            <Viewbox Width="30" Height="30">
              <Canvas Width="64" Height="64">
                <Path Data="M24,18 L21,18 Q17,18 17,23 L17,50 Q17,55 22,55 L44,55 Q49,55 49,50 L49,23 Q49,18 44,18 L42,18"
                      Stroke="{DynamicResource OnAccent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Rectangle Canvas.Left="25" Canvas.Top="11" Width="16" Height="13" RadiusX="4" RadiusY="4" Stroke="{DynamicResource OnAccent}" StrokeThickness="4" />
                <Path Data="M26,35 L40,35 M26,44 L35,44" Stroke="{DynamicResource OnAccent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Canvas>
            </Viewbox>
          </Border>
          <TextBlock Text="ClipTap" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <Button Content="⚙" Width="32" Height="32" Padding="0" Margin="0,0,18,0" FontSize="18" HorizontalAlignment="Right" Background="Transparent" ToolTip="设置" AutomationProperties.Name="设置" Click="OnSettings" />
      </Grid>
      <Border Grid.Row="1" Margin="18,0,18,5" Background="{DynamicResource Chrome}" CornerRadius="9" Padding="4">
        <UniformGrid Columns="2">
          <Button x:Name="HistoryTab" Content="剪贴板历史" Click="OnHistoryTab" Padding="8,6" AutomationProperties.Name="剪贴板历史" />
          <Button x:Name="SnippetsTab" Content="快捷片段" Click="OnSnippetsTab" Padding="8,6" AutomationProperties.Name="快捷片段" />
        </UniformGrid>
      </Border>
      <Grid Grid.Row="2" Margin="24,0">
        <TextBlock x:Name="SectionLabel" Text="最近复制" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
        <TextBlock x:Name="CountLabel" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
      <Grid Grid.Row="3" Margin="12,0">
        <ListBox x:Name="Entries" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single" PreviewMouseLeftButtonUp="OnEntryClick" AutomationProperties.Name="条目列表">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
              <Setter Property="Foreground" Value="{DynamicResource Ink}" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="12,11" /><Setter Property="Margin" Value="0,2" />
              <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Selected}" /><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource SelectedBorder}" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value></Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Glyph}" FontSize="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" />
                <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" Foreground="{DynamicResource Muted}" FontSize="11" />
              </StackPanel>
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
          <TextBlock Text="▤" FontSize="38" Foreground="{DynamicResource EmptyIcon}" HorizontalAlignment="Center" />
          <TextBlock x:Name="EmptyTitle" Margin="0,15,0,8" FontSize="15" HorizontalAlignment="Center" />
          <TextBlock x:Name="EmptyHint" TextAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" MaxWidth="320" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="4" Margin="22,5,22,7">
        <TextBlock x:Name="StatusLabel" Text="仅存于本机 · 加密保存" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}" />
        <StackPanel x:Name="SnippetActions" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="编辑" Click="OnEdit" Padding="10,6" Background="Transparent" Margin="0,0,6,0" />
          <Button Content="＋ 新建片段" Click="OnNew" Padding="10,6" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="5" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="22,0">
        <Grid>
          <TextBlock Text="↑↓ 选择    ←→ 切换    ↵ 粘贴" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" />
          <TextBlock Text="esc 收起" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
