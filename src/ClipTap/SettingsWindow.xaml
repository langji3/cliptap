<Window x:Class="ClipTap.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="设置 · ClipTap" Width="420" Height="530"
        Style="{StaticResource {x:Type Window}}" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,22"><TextBlock Text="保持简单" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="ClipTap 0.1 · 本地剪贴板与快捷片段" Foreground="{DynamicResource Muted}" Margin="0,7,0,0" /></StackPanel>
    <StackPanel Grid.Row="1">
      <TextBlock Text="唤起快捷键" Foreground="{DynamicResource Muted}" />
      <TextBlock Text="Alt + 空格" FontWeight="SemiBold" Margin="0,6,0,15" />
      <CheckBox x:Name="StartupInput" Content="登录 Windows 时启动" />
      <CheckBox x:Name="PauseInput" Content="暂停记录新的剪贴板内容" />
      <Grid Margin="0,16,0,0"><TextBlock Text="外观" VerticalAlignment="Center" /><ComboBox x:Name="ThemeInput" Width="140" Height="32" HorizontalAlignment="Right" SelectionChanged="OnThemeChanged" AutomationProperties.Name="外观主题" /></Grid>
      <Grid Margin="0,12,0,0"><TextBlock Text="主题色" VerticalAlignment="Center" /><ComboBox x:Name="AccentInput" Width="140" Height="32" HorizontalAlignment="Right" SelectionChanged="OnThemeChanged" AutomationProperties.Name="主题色" /></Grid>
      <Grid Margin="0,16,0,18"><TextBlock Text="历史记录上限" VerticalAlignment="Center" /><ComboBox x:Name="LimitInput" Width="95" Height="30" HorizontalAlignment="Right" /></Grid>
      <Button Content="清空剪贴板历史" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource Danger}" Padding="0,8" Click="OnClear" />
      <TextBlock x:Name="ErrorLabel" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" IsCancel="True" Margin="0,0,8,0" /><Button Content="保存设置" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" Click="OnSave" />
    </StackPanel>
  </Grid>
</Window>
