<UserControl x:Class="ClipTap.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClipTap.Views">
  <UserControl.Resources>
    <Style x:Key="Swatch" TargetType="RadioButton">
      <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="Margin" Value="5,0,0,0" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Ring" BorderBrush="Transparent" BorderThickness="2" CornerRadius="16" Padding="4">
          <Grid><Ellipse Fill="{TemplateBinding Background}" /><Ellipse><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#60FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="0.5" /><GradientStop Color="#250C1830" Offset="1" /></LinearGradientBrush></Ellipse.Fill></Ellipse></Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Ink}" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Grid Margin="22,4,22,18">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Grid Margin="0,4,0,18"><TextBlock Text="外观" VerticalAlignment="Center" /><ComboBox x:Name="ThemeInput" Width="138" Height="34" HorizontalAlignment="Right" SelectionChanged="OnThemeChanged" DisplayMemberPath="Label" SelectedValuePath="Mode" AutomationProperties.Name="外观" /></Grid>
        <Grid Margin="0,0,0,18">
          <TextBlock Text="主题色" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <RadioButton x:Name="GreenAccent" Style="{StaticResource Swatch}" Background="#28785D" Tag="Green" ToolTip="绿" AutomationProperties.Name="绿色" Checked="OnAccentChanged" />
            <RadioButton x:Name="BlueAccent" Style="{StaticResource Swatch}" Background="#326CC4" Tag="Blue" ToolTip="蓝" AutomationProperties.Name="蓝色" Checked="OnAccentChanged" />
            <RadioButton x:Name="PurpleAccent" Style="{StaticResource Swatch}" Background="#8057B6" Tag="Purple" ToolTip="紫" AutomationProperties.Name="紫色" Checked="OnAccentChanged" />
          </StackPanel>
        </Grid>
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,18" />
        <CheckBox x:Name="StartupInput" Content="开机启动" Margin="0,6,0,14" />
        <TextBlock Text="唤醒快捷键" Margin="0,0,0,6" />
        <WrapPanel Margin="0,0,0,6">
          <Button x:Name="HotkeyButton" Click="OnRecordHotkey" LostKeyboardFocus="OnHotkeyFocusLost" MinWidth="130" AutomationProperties.Name="录入唤醒快捷键" />
          <Button x:Name="ResetHotkeyButton" Content="恢复默认" Click="OnResetHotkey" Margin="8,0,0,0" Background="Transparent" />
        </WrapPanel>
        <TextBlock x:Name="HotkeyHint" Text="点击录入，保存后生效。支持 Ctrl/Alt 加字母、数字、空格或 F1–F11，可加 Shift。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,12" />
        <Button Content="Windows 剪贴板设置" HorizontalAlignment="Left" Background="Transparent" Padding="0,8" Margin="0,0,0,10" Click="OnSystemSettings" />
        <Button x:Name="ClearButton" Content="清空 Windows 历史" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource Danger}" Padding="0,8" Click="OnClear" />
        <StackPanel x:Name="UpdatePanel" Visibility="Collapsed" Margin="0,18,0,0">
          <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,14" />
          <Grid>
            <TextBlock x:Name="VersionLabel" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
            <Button x:Name="CheckUpdateButton" Content="检查更新" HorizontalAlignment="Right" Click="OnCheckUpdate" />
          </Grid>
          <TextBlock x:Name="UpdateStatusLabel" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
          <Button x:Name="InstallUpdateButton" Content="立即更新" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnInstallUpdate" />
          <Button x:Name="CancelUpdateButton" Content="取消下载" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnCancelUpdate" />
          <Button x:Name="OpenReleaseButton" Content="前往下载页" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnOpenRelease" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <TextBlock x:Name="ErrorLabel" Grid.Row="1" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,8,0,4" />
    <local:InlineConfirmation x:Name="Confirmation" Grid.Row="2" />
    <Button x:Name="SaveButton" Grid.Row="3" Content="保存" HorizontalAlignment="Right" MinWidth="76" Margin="0,8,0,0" Background="{DynamicResource ActionGradient}" Foreground="{DynamicResource OnAccent}" Click="OnSave" />
  </Grid>
</UserControl>
