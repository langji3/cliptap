<UserControl x:Class="ClipTap.Views.InlineConfirmation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Visibility="Collapsed">
  <!-- In-page confirmation on a neutral surface; the destructive verb carries the accent. -->
  <Border Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
          CornerRadius="9" Padding="12" Margin="0,8,0,8">
    <StackPanel>
      <TextBlock x:Name="MessageLabel" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" FontSize="12.5" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button x:Name="CancelButton" Content="取消" Style="{StaticResource QuietButton}" Padding="14,6" Click="OnCancel" />
        <Button x:Name="ConfirmButton" Content="确认" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="8,0,0,0" Click="OnConfirm" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
