<UserControl x:Class="ClipTap.Views.InlineConfirmation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Visibility="Collapsed">
  <Border Background="{DynamicResource Chrome}" CornerRadius="9" Padding="12" Margin="0,8,0,8">
    <StackPanel>
      <TextBlock x:Name="MessageLabel" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" FontSize="12" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button x:Name="CancelButton" Content="取消" Padding="12,6" Background="Transparent" Click="OnCancel" />
        <Button x:Name="ConfirmButton" Content="确认" Padding="12,6" Margin="8,0,0,0" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" Click="OnConfirm" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
