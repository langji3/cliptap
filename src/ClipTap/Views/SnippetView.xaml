<UserControl x:Class="ClipTap.Views.SnippetView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClipTap.Views">
  <UserControl.Resources>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="{DynamicResource CardGradient}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardLine}" />
      <Setter Property="Padding" Value="13,12" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="FieldBorder" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
          <ScrollViewer x:Name="PART_ContentHost" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
      <Setter Property="Padding" Value="13,12" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
        <Border x:Name="FieldBorder" CornerRadius="10" Background="{DynamicResource CardGradient}" BorderBrush="{DynamicResource CardLine}" BorderThickness="1">
          <ScrollViewer x:Name="PART_ContentHost" />
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="OptionSwitch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Margin" Value="0" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0" />
          <Border x:Name="Track" Grid.Column="1" Width="32" Height="18" CornerRadius="9" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <Ellipse x:Name="Knob" Width="10" Height="10" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="3,0" />
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource ActionGradient}" /><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccent}" /><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Grid Margin="20,6,20,18">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="名称" FontSize="12" Foreground="{DynamicResource Muted}" Margin="2,0,0,8" />
        <TextBox x:Name="TitleInput" Height="48" MaxLength="80" FontSize="15" AutomationProperties.Name="片段标题" />
        <TextBlock Text="触发词 · 可选" FontSize="12" Foreground="{DynamicResource Muted}" Margin="2,14,0,8" />
        <Grid>
          <TextBox x:Name="TriggerInput" Height="44" MaxLength="32" FontSize="14" InputMethod.IsInputMethodEnabled="False" AutomationProperties.Name="触发词" ToolTip="输入后自动替换；留空关闭" />
          <TextBlock Text="例如 !hzpass" Margin="13,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=TriggerInput}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </Grid>
        <Grid Margin="2,20,2,8">
          <TextBlock Text="内容" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
          <CheckBox x:Name="RevealInput" Content="显示内容" HorizontalAlignment="Right" Margin="0" Visibility="Collapsed" Checked="OnRevealChanged" Unchecked="OnRevealChanged" />
        </Grid>
        <Grid>
          <TextBox x:Name="ValueInput" Height="130" MaxLength="20000" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="片段内容" />
          <PasswordBox x:Name="SecretInput" Height="130" MaxLength="20000" VerticalContentAlignment="Top" Visibility="Collapsed" AutomationProperties.Name="敏感片段内容" />
        </Grid>
        <Border Margin="0,14,0,0" Padding="12,14" CornerRadius="10" Background="{DynamicResource CardGradient}" BorderBrush="{DynamicResource CardLine}" BorderThickness="1">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <CheckBox x:Name="SensitiveInput" Style="{StaticResource OptionSwitch}" Content="敏感" Checked="OnModeChanged" Unchecked="OnModeChanged" />
            <Border Grid.Column="1" Width="1" Background="{DynamicResource CardLine}" />
            <CheckBox x:Name="PinnedInput" Grid.Column="2" Style="{StaticResource OptionSwitch}" Content="置顶" />
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <TextBlock x:Name="ErrorLabel" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Margin="0,8,0,4" />
    <local:InlineConfirmation x:Name="Confirmation" Grid.Row="2" />
    <Grid Grid.Row="3" Margin="0,8,0,0">
      <Button x:Name="DeleteButton" Content="删除" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource Danger}" Padding="0,9" Click="OnDelete" />
      <Button x:Name="SaveButton" Content="保存片段" HorizontalAlignment="Right" MinWidth="112" Padding="18,11" Background="{DynamicResource ActionGradient}" Foreground="{DynamicResource OnAccent}" Click="OnSave" />
    </Grid>
  </Grid>
</UserControl>
