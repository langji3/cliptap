<UserControl x:Class="ClipTap.Views.SnippetView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClipTap.Views">
  <UserControl.Resources>
    <!-- Option rows are label + switch on one line, without a card wrapper. -->
    <Style x:Key="OptionSwitch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0" />
          <Border x:Name="Track" Grid.Column="1" Width="32" Height="18" CornerRadius="9"
                  Background="{DynamicResource SwitchTrack}" BorderBrush="{DynamicResource Line}" BorderThickness="1" SnapsToDevicePixels="True">
            <Ellipse x:Name="Knob" Width="10" Height="10" Fill="{DynamicResource SwitchKnob}" HorizontalAlignment="Left" Margin="3,0" />
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccent}" />
            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="Margin" Value="2,0,0,7" />
    </Style>
  </UserControl.Resources>
  <Grid Margin="16,2,16,14">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <!-- Scrollable form; the primary action stays pinned at the bottom. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="TitleInput" Height="40" MaxLength="80" FontSize="14" AutomationProperties.Name="片段标题" />
        <TextBlock Text="触发词 · 可选" Style="{StaticResource FieldLabel}" Margin="2,16,0,7" />
        <Grid>
          <TextBox x:Name="TriggerInput" Height="40" MaxLength="32" FontSize="13.5" InputMethod.IsInputMethodEnabled="False" AutomationProperties.Name="触发词" ToolTip="输入后自动替换；留空关闭" />
          <TextBlock Text="例如 !hzpass" Margin="13,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=TriggerInput}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </Grid>
        <Grid Margin="2,16,2,7">
          <TextBlock Text="内容" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
          <CheckBox x:Name="RevealInput" Content="显示内容" HorizontalAlignment="Right" Margin="0" Visibility="Collapsed" Checked="OnRevealChanged" Unchecked="OnRevealChanged" />
        </Grid>
        <Grid>
          <TextBox x:Name="ValueInput" Height="150" MinHeight="110" MaxLength="20000" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="片段内容" />
          <PasswordBox x:Name="SecretInput" Height="150" MinHeight="110" MaxLength="20000" VerticalContentAlignment="Top" Visibility="Collapsed" AutomationProperties.Name="敏感片段内容" />
        </Grid>
        <Grid Margin="2,16,2,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <CheckBox x:Name="SensitiveInput" Style="{StaticResource OptionSwitch}" Content="敏感" Checked="OnModeChanged" Unchecked="OnModeChanged" />
          <Border Grid.Column="1" Width="1" Background="{DynamicResource Line}" Margin="0,2" />
          <CheckBox x:Name="PinnedInput" Grid.Column="2" Style="{StaticResource OptionSwitch}" Content="置顶" Margin="14,0,0,0" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
    <TextBlock x:Name="ErrorLabel" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Margin="0,8,0,0" />
    <local:InlineConfirmation x:Name="Confirmation" Grid.Row="2" />
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Button x:Name="DeleteButton" Content="删除" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
              Foreground="{DynamicResource Danger}" Click="OnDelete" />
      <Button x:Name="SaveButton" Content="保存片段" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
              MinWidth="116" Padding="18,9" Click="OnSave" />
    </Grid>
  </Grid>
</UserControl>
