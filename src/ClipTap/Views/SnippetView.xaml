<UserControl x:Class="ClipTap.Views.SnippetView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClipTap.Views">
  <Grid Margin="22,4,22,18">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="标题" Foreground="{DynamicResource Muted}" Margin="0,0,0,8" />
        <TextBox x:Name="TitleInput" MaxLength="80" AutomationProperties.Name="片段标题" />
        <Grid Margin="0,20,0,8">
          <TextBlock Text="内容" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
          <CheckBox x:Name="SensitiveInput" Content="敏感" HorizontalAlignment="Right" Margin="0" Checked="OnModeChanged" Unchecked="OnModeChanged" />
        </Grid>
        <Grid>
          <TextBox x:Name="ValueInput" Height="132" MaxLength="20000" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="片段内容" />
          <PasswordBox x:Name="SecretInput" Height="132" MaxLength="20000" VerticalContentAlignment="Top" Visibility="Collapsed" AutomationProperties.Name="敏感片段内容" />
        </Grid>
        <Grid Margin="0,14,0,0">
          <CheckBox x:Name="PinnedInput" Content="置顶" />
          <CheckBox x:Name="RevealInput" Content="显示内容" HorizontalAlignment="Right" Visibility="Collapsed" Checked="OnRevealChanged" Unchecked="OnRevealChanged" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
    <TextBlock x:Name="ErrorLabel" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Margin="0,8,0,4" />
    <local:InlineConfirmation x:Name="Confirmation" Grid.Row="2" />
    <Grid Grid.Row="3" Margin="0,8,0,0">
      <Button x:Name="DeleteButton" Content="删除" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource Danger}" Padding="0,9" Click="OnDelete" />
      <Button x:Name="SaveButton" Content="保存" HorizontalAlignment="Right" MinWidth="76" Background="{DynamicResource ActionGradient}" Foreground="{DynamicResource OnAccent}" Click="OnSave" />
    </Grid>
  </Grid>
</UserControl>
